{
	"extends": "@tsconfig/node20/tsconfig.json",
	"compilerOptions": {
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"declaration": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"src/test/fixtures"
	]
}
