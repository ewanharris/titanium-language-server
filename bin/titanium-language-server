#!/usr/bin/env node
'use strict';

// The connection reads its transport from argv (--stdio, --node-ipc, --socket, --pipe), so this
// only has to start the server. It cannot rely on server.js's own `require.main === module`
// guard — that is false when the module is required rather than executed directly.
const { TiLanguageService } = require('../out/server.js');

new TiLanguageService().listen();
