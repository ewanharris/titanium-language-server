{
	"name": "@titanium-sdk/language-server",
	"version": "0.1.0",
	"description": "Language server for Titanium and Alloy projects",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tidev/titanium-language-server.git"
	},
	"homepage": "https://github.com/tidev/titanium-language-server#readme",
	"bugs": {
		"url": "https://github.com/tidev/titanium-language-server/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "out/index.js",
	"types": "out/index.d.ts",
	"exports": {
		".": {
			"types": "./out/index.d.ts",
			"default": "./out/index.js"
		},
		"./server": {
			"types": "./out/server.d.ts",
			"default": "./out/server.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"titanium-language-server": "out/server.js"
	},
	"files": [
		"out/",
		"!out/test",
		"assets/"
	],
	"engines": {
		"node": ">=20.18"
	},
	"scripts": {
		"build": "tsc",
		"prepare": "tsc",
		"watch": "tsc -w",
		"lint": "eslint src/",
		"test": "node --test --experimental-test-coverage --test-coverage-exclude=\"src/test/**\" --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 --test-reporter=spec \"src/test/core/**/*.test.ts\" \"src/test/server/**/*.test.ts\" \"src/test/unit/**/*.test.ts\"",
		"test:e2e": "node --test --test-reporter=spec \"src/test/e2e/**/*.test.ts\"",
		"test:debug": "node --test --test-reporter=spec \"src/test/core/**/*.test.ts\" \"src/test/server/**/*.test.ts\" \"src/test/unit/**/*.test.ts\""
	},
	"dependencies": {
		"semver": "^7.8.5",
		"typescript": "^6.0.3",
		"vscode-html-languageservice": "^5.6.2",
		"vscode-languageserver": "^10.1.1",
		"vscode-languageserver-textdocument": "^1.0.14",
		"vscode-uri": "^3.2.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tsconfig/node20": "^20.1.10",
		"@types/node": "~20.17.0",
		"@types/semver": "^7.8.0",
		"eslint": "^10.10.0",
		"typescript-eslint": "^8.69.0"
	}
}
