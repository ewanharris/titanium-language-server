{
  "name": "titanium-language-server",
  "version": "1.0.0",
  "description": "",
  "main": "out/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "c8 mocha \"out/test/**/*.test.js\" --timeout 20000",
    "test:debug": "mocha \"out/test/**/*.test.js\" --timeout 99999",
    "watch": "tsc -w"
  },
  "files": [
    "out/",
    "!out/test"
  ],
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@tsconfig/node14": "^1.0.1",
    "@types/chai": "^4.2.22",
    "@types/fs-extra": "^11.0.1",
    "@types/klaw": "^3.0.3",
    "@types/mocha": "^10.0.1",
    "@types/node": "14.14.31",
    "@types/sinon": "^10.0.6",
    "@types/xml2js": "^0.4.9",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "c8": "^7.13.0",
    "chai": "^4.3.4",
    "eslint": "^8.39.0",
    "eslint-config-axway": "^8.0.0",
    "mocha": "^10.2.0",
    "sinon": "^15.0.4",
    "ts-node": "^10.4.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "fs-extra": "^11.1.1",
    "klaw": "^4.0.1",
    "titanium-editor-commons": "^2.1.0",
    "vscode-languageserver": "^7.0.0",
    "vscode-languageserver-textdocument": "^1.0.2",
    "vscode-uri": "^3.0.2",
    "xml2js": "^0.5.0"
  },
  "engines": {
    "node": ">=14.x"
  },
  "c8": {
    "include": [
      "out/",
      "!out/test",
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/test/**"
    ],
    "reporter": [
      "text",
      "html",
      "lcov",
      "cobertura"
    ],
    "all": true
  }
}
